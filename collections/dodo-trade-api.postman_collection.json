          "id": "8f419150-8e2d-48c5-8c26-8f7fad659f38",
          "name": "Get a swap route quote",
          "request": {
            "name": "Get a swap route quote",
            "description": {
              "content": "Returns a real-time price quote and executable ABI calldata for swapping `fromAmount` of `fromTokenAddress` into `toTokenAddress` on the given chain, routed across DODO's aggregated liquidity sources. Use the native token sentinel address 0xEeeeeEeeeEeEeeEeEeEeeEEEeeeeEeeeeeeeEEeE for ETH/BNB/MATIC.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dodoapi",
                "getdodoroute"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fromTokenAddress",
                  "value": "<string>",
                  "description": "(Required) Contract address of the token to sell (native sentinel for ETH/BNB/MATIC)."
                },
                {
                  "disabled": false,
                  "key": "fromTokenDecimals",
                  "value": "<integer>",
                  "description": "(Required) Decimals of the token to sell."
                },
                {
                  "disabled": false,
                  "key": "toTokenAddress",
                  "value": "<string>",
                  "description": "(Required) Contract address of the token to buy (native sentinel for ETH/BNB/MATIC)."
                },
                {
                  "disabled": false,
                  "key": "toTokenDecimals",
                  "value": "<integer>",
                  "description": "(Required) Decimals of the token to buy."
                },
                {
                  "disabled": false,
                  "key": "fromAmount",
                  "value": "<string>",
                  "description": "(Required) Amount of the token to sell, expressed with decimals (e.g. 1 ETH = 10**18)."
                },
                {
                  "disabled": false,
                  "key": "slippage",
                  "value": "<integer>",
                  "description": "(Required) Allowed slippage, 0-100 (unit percent)."
                },
                {
                  "disabled": false,
                  "key": "userAddr",
                  "value": "<string>",
                  "description": "(Required) User wallet address that will execute the swap."
                },
                {
                  "disabled": false,
                  "key": "chainId",
                  "value": "<integer>",
                  "description": "(Required) Chain id: 1 Ethereum, 56 BSC, 66 OEC, 128 HECO, 137 Polygon, 42161 Arbitrum One, 1285 MoonRiver, 1313161554 Aurora, 288 Boba, 43114 Avalanche."
                },
                {
                  "disabled": false,
                  "key": "rpc",
                  "value": "<string>",
                  "description": "(Required) Your own RPC node URL used for on-chain reads."
                },
                {
                  "disabled": false,
                  "key": "deadLine",
                  "value": "<integer>",
                  "description": "Unix timestamp (seconds) of the trade deadline block."
                },
                {
                  "disabled": false,
                  "key": "source",
                  "value": "<string>",
                  "description": "Restrict liquidity sources. If blank, all sources are quoted; set to \"dodo\" to quote DODO v1 and DODO v2 only."
                }
              ],
              "variable": []
            },
            "header": [
